{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zeb",
  "version": "0.1.3",
  "identifier": "com.sahil.zeb",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zeb",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFNDYzODA4MUQwMDFDREYKUldUZkhBQWRDRGhHVHFTeU5ZMnhrZ3djdk9FbTBDZ1Voa0xYRXJlMzVvbVVXZldVckFvdXZrYjIK",
      "endpoints": [
        "https://github.com/sahilcodex/zeb/releases/latest/download/latest.json"
      ]
    }
  }
}
